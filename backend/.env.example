SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
MAX_PDF_SIZE_MB=100

# Where PDF2EPUB, the conversion engine, comes from (no quotes; ~ isn't expanded):
#   a folder, for development: installed editable, so changes there show up at once
#     PDF2EPUB_SOURCE=/home/you/Projects/PDF2EPUB
#   anything pip installs, for production, such as a release tag
PDF2EPUB_SOURCE=git+https://github.com/andriaberi/PDF2EPUB.git@v2026.1025.3

# Email, through Gmail: the account, and an app password made for it at
# https://myaccount.google.com/apppasswords (2-step verification must be on).
# Without a password, emails are printed to the console instead of sent.
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=
# Who hears about new suggestions and messages (the account above if left out)
NOTIFY_EMAIL=
# The site's address, for links in emails
SITE_URL=http://localhost:8000
